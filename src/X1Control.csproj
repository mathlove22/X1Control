<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>X1Control</AssemblyName><Version>1.1.3</Version><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\X1Control.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6"/></ItemGroup>
  <ItemGroup><Resource Include="Assets\X1Control.png"/></ItemGroup>
</Project>
